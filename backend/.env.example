# Backend env vars read by the Express API.
# Copy this file to .env and fill in real values before running or deploying.

PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/EtherXMeet

JWT_SECRET=EtherXMeet_super_secret_key_2026
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Browser origins allowed by CORS and meeting sockets (comma-separated lists are fine).
# In production only these are allowed; in development localhost and LAN addresses also work.
CLIENT_URL=http://localhost:3000
# Optional LAN client URL for local network testing.
CLIENT_URL_LAN=

EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key
# Meeting invitations. Template variables: {{to_email}}, {{host_name}}, {{meeting_link}}, {{room_code}}.
# Unset or failing: the inviter gets a mail draft to send from their own mail app.
EMAILJS_INVITE_TEMPLATE_ID=

# TURN relay for meetings across strict NATs/firewalls (coturn, Metered, Twilio, ...).
# Comma-separated URLs, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
# Unset: a free public relay is used, which is fine for testing only.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
