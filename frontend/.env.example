# ── API / Signaling server (Socket.IO for WebRTC video/audio) ────────────────
VITE_API_BASE_URL=http://localhost:5000
VITE_MEETING_API_BASE_URL=http://localhost:4000

# 100ms meeting server credentials
VITE_100MS_APP_KEY=your_key
VITE_100MS_APP_SECRET=your_secret
VITE_100MS_DEFAULT_ROLE=host

# ── Pinata IPFS ──────────────────────────────────────────────────────────────
VITE_PINATA_JWT=your_pinata_jwt

# Public gateway for fetching pinned content
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# ── Network ───────────────────────────────────────────────────────────────────
# "localhost" → Hardhat local node (chainId 31337)
# "mainnet"   → Polygon mainnet (chainId 137)
VITE_NETWORK=localhost

# ── MetaMask Embedded Wallets (formerly Web3Auth) ──────────────────────────────
VITE_WEB3AUTH_CLIENT_ID=BJWOh3Ah_1encexK_CbgVKwKLdJOls5JDRxFDtDoRCjmvkPvPdsXl0ewfrHpnXFO2trK5ffNkp4xw5FZAapwjWI

# ── Legal pages ──────────────────────────────────────────────────────────────
# Links shown under "By continuing, you agree to…" on the start page; the line is hidden until both are set.
VITE_TERMS_URL=
VITE_PRIVACY_URL=
