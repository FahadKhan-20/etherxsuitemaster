# Frontend env vars read by Vite.
# Copy this file to .env and fill in real values before running or building.

VITE_API_BASE_URL=http://localhost:5000
VITE_MEETING_API_BASE_URL=http://localhost:4000

# 100ms meeting server credentials.
VITE_100MS_APP_KEY=your_key
VITE_100MS_APP_SECRET=your_secret
VITE_100MS_DEFAULT_ROLE=host

# Pinata IPFS.
VITE_PINATA_JWT=your_pinata_jwt_here
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# Network: "localhost" (Hardhat) | "amoy" (Polygon Amoy testnet) | "mainnet" (Polygon)
VITE_NETWORK=localhost

# LiveKit WebSocket URL.
VITE_LIVEKIT_WS_URL=wss://etherxmeet-9kvqnuhc.livekit.cloud

# MetaMask Embedded Wallets / Web3Auth client ID.
VITE_WEB3AUTH_CLIENT_ID=your_web3auth_client_id_here

# Optional Socket.IO override for the WebRTC signaling server.
VITE_SOCKET_URL=http://localhost:4000
