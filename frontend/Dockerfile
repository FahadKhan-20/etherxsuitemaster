FROM node:20-alpine AS build

WORKDIR /app

ARG VITE_API_BASE_URL=/
ARG VITE_MEETING_API_BASE_URL=/meeting-api
ARG VITE_SOCKET_URL=/
ARG VITE_100MS_APP_KEY
ARG VITE_100MS_APP_SECRET
ARG VITE_100MS_DEFAULT_ROLE=host
ARG VITE_PINATA_JWT
ARG VITE_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
ARG VITE_NETWORK=localhost
ARG VITE_LIVEKIT_WS_URL
ARG VITE_WEB3AUTH_CLIENT_ID
ARG VITE_CONTRACT_ADDRESS
ARG VITE_POLYGON_RPC_URL

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_MEETING_API_BASE_URL=${VITE_MEETING_API_BASE_URL}
ENV VITE_SOCKET_URL=${VITE_SOCKET_URL}
ENV VITE_100MS_APP_KEY=${VITE_100MS_APP_KEY}
ENV VITE_100MS_APP_SECRET=${VITE_100MS_APP_SECRET}
ENV VITE_100MS_DEFAULT_ROLE=${VITE_100MS_DEFAULT_ROLE}
ENV VITE_PINATA_JWT=${VITE_PINATA_JWT}
ENV VITE_PINATA_GATEWAY=${VITE_PINATA_GATEWAY}
ENV VITE_NETWORK=${VITE_NETWORK}
ENV VITE_LIVEKIT_WS_URL=${VITE_LIVEKIT_WS_URL}
ENV VITE_WEB3AUTH_CLIENT_ID=${VITE_WEB3AUTH_CLIENT_ID}
ENV VITE_CONTRACT_ADDRESS=${VITE_CONTRACT_ADDRESS}
ENV VITE_POLYGON_RPC_URL=${VITE_POLYGON_RPC_URL}

COPY package*.json ./
RUN npm ci --legacy-peer-deps

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
