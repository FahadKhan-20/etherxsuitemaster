# Root environment template for the Docker deployment.
# Copy to .env and fill in real values before starting containers.

# Public origin used by backend redirects and callback URLs.
# For local Docker testing this defaults to the frontend port mapping.
PUBLIC_ORIGIN=http://localhost:8080

# MongoDB for the backend container.
MONGO_URI=mongodb://mongo:27017/EtherXMeet

# Backend runtime.
PORT=5000
NODE_ENV=production
JWT_SECRET=change_me_before_deploying
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:8080
CLIENT_URL_LAN=http://localhost:8080
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_WS_URL=wss://your-project.livekit.cloud

# Contract / Polygon.
POLYGON_RPC_URL=https://rpc-mumbai.maticvigil.com
POLYGON_MAINNET_RPC_URL=https://polygon-rpc.com
POLYGONSCAN_API_KEY=your_polygonscan_api_key
PRIVATE_KEY=your_deployer_private_key
CONTRACT_ADDRESS=
VITE_CONTRACT_ADDRESS=
VITE_POLYGON_RPC_URL=

# Frontend build-time env.
# These are embedded into the Vite bundle during docker compose build.
VITE_API_BASE_URL=/
VITE_MEETING_API_BASE_URL=/meeting-api
VITE_SOCKET_URL=/
VITE_100MS_APP_KEY=your_100ms_app_key
VITE_100MS_APP_SECRET=your_100ms_app_secret
VITE_100MS_DEFAULT_ROLE=host
VITE_PINATA_JWT=your_pinata_jwt_here
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
VITE_NETWORK=localhost
VITE_LIVEKIT_WS_URL=wss://your-project.livekit.cloud
VITE_WEB3AUTH_CLIENT_ID=your_web3auth_client_id
