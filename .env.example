# .env.example — copy to .env and fill in values before deploying
# ─────────────────────────────────────────────────────────────────

# Polygon network RPCs
POLYGON_RPC_URL=your_polygon_rpc_url_here
POLYGON_MAINNET_RPC_URL=your_polygon_mainnet_rpc_url_here

# Deployer wallet private key (never commit the real .env file!)
PRIVATE_KEY=your_private_key_here

# Polygonscan API key for contract verification (https://polygonscan.com/apis)
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# Populated automatically by scripts/deploy.js — also set manually if needed
CONTRACT_ADDRESS=your_contract_address_here

# ─── Vite (frontend) env vars ────────────────────────────────────
# These are read by Vite at build time (must start with VITE_)
# NOTE: The deploy script writes the address directly to
#       frontend/src/contracts/MeetingRegistry.json — these VITE_ vars
#       are optional convenience copies for CI or manual overrides.
VITE_CONTRACT_ADDRESS=your_vite_contract_address_here
VITE_POLYGON_RPC_URL=your_vite_polygon_rpc_url_here

# Set to "mainnet" to link ChainBadge tx hashes to polygonscan.com instead of mumbai
VITE_NETWORK=your_vite_network_here


VITE_100MS_APP_KEY=your_vite_100ms_app_key_here
VITE_100MS_APP_SECRET=your_vite_100ms_app_secret_here
VITE_100MS_DEFAULT_ROLE=your_vite_100ms_default_role_here
VITE_API_BASE_URL=your_vite_api_base_url_here
VITE_MEETING_API_BASE_URL=your_vite_meeting_api_base_url_here
PORT=your_port_here

# Polygon / Web3
VITE_CONTRACT_ADDRESS=your_vite_contract_address_here
VITE_PINATA_JWT=your_vite_pinata_jwt_here
VITE_PINATA_GATEWAY=your_vite_pinata_gateway_here
